# Küa Tasks — copy to .env.local and fill in.
#
# All four are needed. `npm run build` deliberately succeeds without them so a
# missing variable surfaces as a readable screen rather than a build failure,
# which means an empty file here fails at runtime instead — check /api/health,
# which reports which ones are present and whether the database answers.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key. Safe in the browser: every table is behind RLS and
# an uninvited caller reads empty sets. Verified by `npm run verify:db`.
# Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key. Bypasses RLS entirely — server actions, route handlers
# and the verification scripts only. It must never reach a client bundle; the
# build is checked for it before each deploy.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links come back to. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-deployment.vercel.app
#
# This is what the login page hands Supabase as emailRedirectTo, so if it is
# wrong the link in the email is wrong — it points at localhost from production,
# which is the exact failure this variable exists to prevent. The same URL also
# has to be in Supabase → Authentication → URL Configuration → Redirect URLs,
# or the link is refused on arrival.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
